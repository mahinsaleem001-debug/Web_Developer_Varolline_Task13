# Copy to .env and adjust. For local development none of this is required: `npm run dev` works out of the box.

PORT=3000
APP_ORIGIN=http://localhost:3000

# --- Object storage (AWS S3, MinIO, Cloudflare R2, ...) ---
# Leave S3_ENDPOINT empty for AWS S3. For MinIO use e.g. http://localhost:9000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Limits ---
MAX_FILE_MB=10
MAX_FILES_PER_USER=200
MAX_USER_MB=500

# --- Production ---
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=true
# APP_ORIGIN=https://your-app.example
